rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /militares/{militarId} {
      allow read: if true;
      allow write: if true;
    }
    match /fais/{faiId} {
      allow read: if true;
      allow write: if true;
    }
    match /impugnacoes/{impugnacaoId} {
      allow read: if true;
      allow write: if true;
    }
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    match /configuracoes/{configId} {
      allow read: if true;
      allow write: if true;
    }
    match /audit_logs/{logId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }
  }
}
